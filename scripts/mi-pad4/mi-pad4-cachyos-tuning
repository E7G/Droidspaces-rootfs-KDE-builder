#!/usr/bin/bash
set -u

log() { printf '[mi-pad4-cachyos] %s\n' "$*" >&2; }

apply_sysctl() {
    local key="$1" value="$2" path="/proc/sys/${1//./\/}"
    [ -e "$path" ] || return 0
    /usr/bin/sysctl -e -w "$key=$value" >/dev/null 2>&1 || true
}

# CachyOS 70-cachyos-settings.conf, with smaller dirty limits for a 4 GiB
# tablet. sysctl -e keeps old Android kernels compatible with newer settings.
# Android shares this 4 GiB memory pool with the guest. Avoid the aggressive
# CachyOS desktop defaults, which turn normal Plasma interaction into zram I/O.
apply_sysctl vm.swappiness 60
apply_sysctl vm.vfs_cache_pressure 50
apply_sysctl vm.dirty_bytes 33554432
apply_sysctl vm.dirty_background_bytes 8388608
apply_sysctl vm.dirty_writeback_centisecs 1500
apply_sysctl vm.page-cluster 0
apply_sysctl kernel.nmi_watchdog 0
apply_sysctl kernel.unprivileged_userns_clone 1
apply_sysctl kernel.printk '3 3 3 3'
apply_sysctl kernel.kptr_restrict 2
apply_sysctl net.core.netdev_max_backlog 4096
apply_sysctl fs.file-max 1048576

# Prefer schedutil when the host kernel exposes it. Never force performance:
# the tablet's thermal and battery limits are more important than peak clocks.
for governor in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$governor" ] || continue
    available="${governor%/scaling_governor}/scaling_available_governors"
    if [ -r "$available" ] && grep -qw schedutil "$available"; then
        printf '%s\n' schedutil >"$governor" 2>/dev/null || true
    fi
done

# Match CachyOS's storage policy, but only select schedulers the kernel offers.
for scheduler in /sys/block/*/queue/scheduler; do
    [ -w "$scheduler" ] || continue
    device="${scheduler#/sys/block/}"
    device="${device%%/*}"
    wanted=""
    case "$device" in
        nvme*) wanted=kyber ;;
        mmcblk*|sd*) wanted=mq-deadline ;;
    esac
    [ -n "$wanted" ] || continue
    grep -qw "$wanted" "$scheduler" || continue
    printf '%s\n' "$wanted" >"$scheduler" 2>/dev/null || true
done

# Avoid THP compaction stalls where the old kernel supports the safer mode.
thp_defrag=/sys/kernel/mm/transparent_hugepage/defrag
if [ -w "$thp_defrag" ] && grep -qw defer+madvise "$thp_defrag"; then
    printf '%s\n' defer+madvise >"$thp_defrag" 2>/dev/null || true
fi

mkdir -p /run/droidspaces 2>/dev/null || true
printf '%s\n' 'cachyos=portable-mi-pad4' 'scheduler=schedutil-if-available' \
    'v4l2-m2m=kept' 'kgsl=kept' > /run/droidspaces/cachyos-mi-pad4.applied 2>/dev/null || true
log 'portable CachyOS tuning applied'
