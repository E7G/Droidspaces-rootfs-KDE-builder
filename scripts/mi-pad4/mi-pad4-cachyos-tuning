#!/usr/bin/bash
set -u

log() { printf '[mi-pad4-performance] %s\n' "$*" >&2; }

apply_sysctl() {
    local key="$1" value="$2" path="/proc/sys/${1//./\/}"
    [ -e "$path" ] || return 0
    /usr/bin/sysctl -e -w "$key=$value" >/dev/null 2>&1 || true
}

# Device-specific VM profile. The Android host and guest share 4 GiB, so the
# goal is to keep interactive frames resident while still allowing Android's
# shared-memory pressure to reclaim cold pages.
apply_sysctl vm.swappiness 20
apply_sysctl vm.vfs_cache_pressure 75
apply_sysctl vm.dirty_bytes 16777216
apply_sysctl vm.dirty_background_bytes 4194304
apply_sysctl vm.dirty_writeback_centisecs 3000
apply_sysctl vm.dirty_expire_centisecs 3000
apply_sysctl vm.page-cluster 0
apply_sysctl kernel.nmi_watchdog 0
apply_sysctl kernel.unprivileged_userns_clone 1
apply_sysctl kernel.printk '3 3 3 3'
apply_sysctl kernel.kptr_restrict 2
apply_sysctl net.core.netdev_max_backlog 4096
apply_sysctl fs.file-max 131072
apply_sysctl vm.compaction_proactiveness 0
apply_sysctl vm.watermark_boost_factor 0
apply_sysctl fs.inotify.max_user_instances 128
apply_sysctl fs.inotify.max_user_watches 8192

# SDM660 has separate little/big policies. schedutil is retained, but its
# response is made fast enough for Wayland frame deadlines without pinning
# either cluster at performance (which only creates heat and throttling).
for policy in /sys/devices/system/cpu/cpufreq/policy* /sys/devices/system/cpu/cpu*/cpufreq; do
    [ -d "$policy" ] || continue
    governor="$policy/scaling_governor"
    [ -w "$governor" ] || continue
    available="$policy/scaling_available_governors"
    if [ -r "$available" ] && grep -qw schedutil "$available"; then
        printf '%s\n' schedutil >"$governor" 2>/dev/null || true
    fi
    for knob_value in \
        "$policy/schedutil/up_rate_limit_us=500" \
        "$policy/schedutil/down_rate_limit_us=20000"; do
        knob="${knob_value%%=*}"
        value="${knob_value#*=}"
        [ -w "$knob" ] && printf '%s\n' "$value" >"$knob" 2>/dev/null || true
    done
done

# Match CachyOS's storage policy, but only select schedulers the kernel offers.
for scheduler in /sys/block/*/queue/scheduler; do
    [ -w "$scheduler" ] || continue
    device="${scheduler#/sys/block/}"
    device="${device%%/*}"
    wanted=""
    case "$device" in
        nvme*) wanted=kyber ;;
        mmcblk*|sd*) wanted=mq-deadline ;;
    esac
    [ -n "$wanted" ] || continue
    grep -qw "$wanted" "$scheduler" || continue
    printf '%s\n' "$wanted" >"$scheduler" 2>/dev/null || true
done

# Avoid THP compaction stalls where the old kernel supports the safer mode.
thp_defrag=/sys/kernel/mm/transparent_hugepage/defrag
if [ -w "$thp_defrag" ] && grep -qw defer+madvise "$thp_defrag"; then
    printf '%s\n' defer+madvise >"$thp_defrag" 2>/dev/null || true
fi

mkdir -p /run/droidspaces 2>/dev/null || true
printf '%s\n' 'profile=mi-pad4-sdm660-4gb' 'memory=swappiness20-page-cluster0' \
    'cpu=schedutil-fast-up-low-idle' 'storage=kernel-selected' 'v4l2-m2m=kept' \
    'kgsl=kept' > /run/droidspaces/mi-pad4-performance.applied 2>/dev/null || true
log 'device-specific SDM660 profile applied'
