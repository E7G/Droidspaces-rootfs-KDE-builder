#!/bin/bash

set -u

export HOME=/home/user
export USER=user
export LOGNAME=user
export LANG=zh_CN.UTF-8
export LANGUAGE=zh_CN:zh
export LC_ALL=zh_CN.UTF-8
export WAYLAND_DISPLAY=wayland-0
export QT_QPA_PLATFORM=wayland
export ANLAND=1
export ANLAND_SOCKET=/run/display.sock
export ANLAND_DRM_DEVICE=/dev/dri/renderD128
export XDG_RUNTIME_DIR=/run/user/1000
export XMODIFIERS=@im=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=fcitx
export LIBGL_ALWAYS_SOFTWARE=1
export QT_QUICK_BACKEND=software
export QT_OPENGL=software
export QT_QPA_PLATFORMTHEME=KDE
export QT_QUICK_CONTROLS_STYLE=org.kde.breeze
export QT_ENABLE_GLYPH_CACHE_WORKAROUND=1
# The KDE portal backend inherits KWin's KGSL/legacy-ION environment and crashes
# on the 4.4 kernel; its document FUSE helper can then spin forever. Native KDE
# dialogs work without it and save memory/CPU on this 4 GB tablet.
export PLASMA_INTEGRATION_USE_PORTAL=0
export GTK_USE_PORTAL=0
export MALLOC_ARENA_MAX=2
export PLASMA_DEFAULT_SHELL=org.kde.plasma.desktop
export XDG_CONFIG_DIRS="/etc/xdg${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"

if [[ "$EUID" -eq 0 ]]; then
  install -d -m 700 -o user -g user "$XDG_RUNTIME_DIR"
  install -d -m 700 -o user -g user \
    "$HOME/.cache" "$HOME/.cache/fontconfig" \
    "$HOME/.local" "$HOME/.local/share" "$HOME/.local/share/kactivitymanagerd"
  install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix
else
  mkdir -p "$XDG_RUNTIME_DIR" "$HOME/.cache/fontconfig" "$HOME/.local/share/kactivitymanagerd"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

live_plasmashell_pid() {
  local pid state
  for pid in $(pgrep -x plasmashell 2>/dev/null || true); do
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    if [[ -n "$state" && "$state" != Z* ]]; then
      echo "$pid"
      return 0
    fi
  done
  return 1
}

latest_live_pid() {
  local pattern="$1" pid state newest=""
  for pid in $(pgrep -f "$pattern" 2>/dev/null || true); do
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    if [[ -n "$state" && "$state" != Z* ]]; then
      newest="$pid"
    fi
  done
  [[ -n "$newest" ]] || return 1
  echo "$newest"
}

if [[ "${1:-}" != child && "${1:-}" != shell ]]; then
  # runit supervises this one foreground service.  Keep KWin and the user
  # session as siblings so a failed compositor causes one clean restart rather
  # than leaving a second Plasma session behind.
  "$0" child >>/var/log/plasma-conc-wayland.log 2>&1 &
  child_pid=$!
  /usr/sbin/runuser -u user -- "$0" shell >>/home/user/plasma-conc-shell.log 2>&1 &
  shell_pid=$!

  cleanup() {
    kill "$child_pid" "$shell_pid" 2>/dev/null || true
    wait "$child_pid" "$shell_pid" 2>/dev/null || true
  }
  trap cleanup EXIT INT TERM

  process_alive() {
    local pid="$1" state
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    [[ -n "$state" && "$state" != Z* ]]
  }

  while process_alive "$child_pid" && process_alive "$shell_pid"; do
    sleep 2
  done
  exit 1
fi

# Keep KWin at its packaged path so its internal QPA plugin resolves correctly.
# Only this child receives KGSL and the legacy ION shim; the desktop shell helper
# below stays on stable software/shared-memory buffers.
if [[ "${1:-}" = child ]]; then
  unset LIBGL_ALWAYS_SOFTWARE
  unset QT_QUICK_BACKEND
  unset QT_OPENGL
  export MESA_LOADER_DRIVER_OVERRIDE=kgsl
  export GALLIUM_DRIVER=kgsl
  export FD_FORCE_KGSL=1
  export LD_PRELOAD=/usr/local/lib/libion-legacy-shim.so
  exec /usr/sbin/runuser -u user -- /usr/bin/dbus-run-session -- /usr/bin/startplasma-wayland
fi

for _ in $(seq 1 45); do
  session_pid="$(latest_live_pid '(^|/)startplasma-wayland($| )' || true)"
  kwin_pid="$(latest_live_pid '(^|/)kwin_wayland($| )' || true)"
  if [[ -n "$session_pid" && -n "$kwin_pid" && -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
    # A stale Wayland socket survives a fast container restart.  Requiring the
    # new compositor process, then allowing its output two seconds to settle,
    # prevents Plasma from binding its panel to screen -1.
    sleep 2
    break
  fi
  sleep 1
done

if shell_pid="$(live_plasmashell_pid)"; then
  echo "plasmashell already running: $shell_pid"
  exit 0
fi

if [[ -z "${session_pid:-}" ]]; then
  echo "startplasma-wayland did not become ready" >&2
  exit 1
fi

dbus_address="$(tr '\0' '\n' < "/proc/$session_pid/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)"
session_display="$(tr '\0' '\n' < "/proc/$session_pid/environ" | sed -n 's/^DISPLAY=//p' | head -n 1)"
if [[ -z "$dbus_address" ]]; then
  echo "DBUS_SESSION_BUS_ADDRESS not found for PID $session_pid" >&2
  exit 1
fi

export DBUS_SESSION_BUS_ADDRESS="$dbus_address"
export DISPLAY="${session_display:-:0}"
export QSG_RENDER_LOOP=basic

# startplasma normally delegates these user services to systemd. Kernel 4.4
# cannot keep a systemd user manager alive, so launch the audio graph directly.
# Without a PipeWire server the Anland audio reconnect loop sits on a dead core
# socket and wastes one CPU core.
if ! pgrep -x pipewire >/dev/null 2>&1; then
  nohup /usr/bin/pipewire >"$HOME/pipewire.log" 2>&1 </dev/null &
fi
for _ in $(seq 1 10); do
  [[ -S "$XDG_RUNTIME_DIR/pipewire-0" ]] && break
  sleep 0.2
done
if ! pgrep -x pipewire-pulse >/dev/null 2>&1; then
  nohup /usr/bin/pipewire-pulse >"$HOME/pipewire-pulse.log" 2>&1 </dev/null &
fi
if ! pgrep -x wireplumber >/dev/null 2>&1; then
  nohup /usr/bin/wireplumber >"$HOME/wireplumber.log" 2>&1 </dev/null &
fi

# KActivityManager must use the shell's software environment.  When it inherits
# KWin's KGSL/legacy-ION environment it crashes before Plasma can load.
if ! pgrep -f '(^|/)kactivitymanagerd($| )' >/dev/null 2>&1; then
  nohup /usr/lib/aarch64-linux-gnu/libexec/kactivitymanagerd \
    >"$HOME/kactivitymanagerd.log" 2>&1 </dev/null &
fi
for _ in $(seq 1 10); do
  pgrep -f '(^|/)kactivitymanagerd($| )' >/dev/null 2>&1 && break
  sleep 1
done
if ! pgrep -f '(^|/)kactivitymanagerd($| )' >/dev/null 2>&1; then
  echo "kactivitymanagerd did not become ready; continuing with Plasma desktop" >&2
fi

fcitx5 -d --replace >/home/user/fcitx5.log 2>&1 || true
exec /usr/bin/plasmashell -p org.kde.plasma.desktop
