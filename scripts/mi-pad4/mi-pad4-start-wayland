#!/bin/bash

set -u

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/tmp/droidspaces-home
export USER=user
export LOGNAME=user
export SHELL=/usr/bin/bash
export BASH=/usr/bin/bash
export LANG=zh_CN.UTF-8
export LANGUAGE=zh_CN:zh
export LC_ALL=zh_CN.UTF-8
export WAYLAND_DISPLAY=wayland-0
export QT_QPA_PLATFORM=wayland
export ANLAND=1
export ANLAND_SOCKET=/run/display.sock
# Mi Pad 4's KGSL node is not a DRM/GBM render node. The patched backend must
# select its surfaceless EGL path instead of forcing RenderDevice::open().
unset ANLAND_DRM_DEVICE
# Droidspaces' bind-mounted runtime can create unreadable Wayland lock files on
# the 4.4 kernel. Anland uses ANLAND_SOCKET independently, so keep the Linux
# session socket graph in the container's normal /run tmpfs.
export XDG_RUNTIME_DIR=/run/droidspaces-runtime/user-0
# KDE cache lock files on HOME's Android /data bind mount can become unreadable
# (ENOKEY) on the clover 4.4 kernel. KConfig then recursively creates
# *.rmlock files and blocks KWin's event loop, so keep all disposable XDG cache
# data in the container-owned /run tmpfs.
export XDG_CACHE_HOME=/run/droidspaces-cache/user-0
# Plasma's KUserFeedback and Dolphin also take KConfig locks below XDG state.
# Keep those transient state files off the same fscrypt-affected bind mount.
export XDG_STATE_HOME=/run/droidspaces-state/user-0
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export XKB_DEFAULT_RULES=evdev
export XKB_DEFAULT_MODEL=pc105
export XKB_DEFAULT_LAYOUT=us
unset XKB_DEFAULT_VARIANT XKB_DEFAULT_OPTIONS
# Android's IME is bridged by Anland. Keep native Wayland text-input enabled so
# KWin can notify the Anland backend when a Linux text field gains focus, while
# avoiding a second Linux virtual keyboard and Fcitx candidate-window flicker.
unset XMODIFIERS GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE GLFW_IM_MODULE
export QT_IM_MODULES=wayland
export LIBGL_ALWAYS_SOFTWARE=1
export QT_QUICK_BACKEND=software
export QT_OPENGL=software
export QT_QPA_PLATFORMTHEME=KDE
export QT_QUICK_CONTROLS_STYLE=org.kde.breeze
export QT_ENABLE_GLYPH_CACHE_WORKAROUND=1
# The KDE portal backend inherits KWin's KGSL/legacy-ION environment and crashes
# on the 4.4 kernel; its document FUSE helper can then spin forever. Native KDE
# dialogs work without it and save memory/CPU on this 4 GB tablet.
export PLASMA_INTEGRATION_USE_PORTAL=0
export GTK_USE_PORTAL=0
export MALLOC_ARENA_MAX=2
export PLASMA_DEFAULT_SHELL=org.kde.plasma.desktop
export XDG_CONFIG_DIRS="/etc/xdg${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"
# plasmashell is launched outside plasma_session on this legacy guest. Seed the
# session metadata it normally inherits so KDE menus and services resolve.
export KDE_FULL_SESSION=true
export KDE_SESSION_VERSION=6
export XDG_CURRENT_DESKTOP=KDE
# This container has no working systemd user manager. Plasma's scope launcher
# would issue session-bus requests that cannot be completed on this kernel.
export KDE_APPLICATIONS_AS_SCOPE=0
export XDG_MENU_PREFIX=plasma-
export XDG_SESSION_TYPE=wayland
export QT_WAYLAND_RECONNECT=1
export _JAVA_AWT_WM_NONREPARENTING=1
export KDE_USE_SYSTEMD=0
# KIO's in-process file worker is faster but a worker fault terminates Dolphin.
# The Android/fscrypt-backed rootfs can return ENOKEY during metadata probes, so
# keep file workers out of process and let Dolphin survive a failed worker.
export KIO_ENABLE_WORKER_THREADS=0

# systemd's service-manager variables make Plasma 6 treat this system service
# as a user session. The old kernel has no usable user manager, so do not pass
# that detection signal into dbus-run-session or its descendants.
unset INVOCATION_ID NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC SYSTEMD_EXEC_PID

if [[ "$EUID" -eq 0 ]]; then
  # The 4.4 container lacks CAP_SETUID/CAP_SETGID under Enforcing.  Do not
  # call runuser or chown here; use a private writable runtime/home instead.
  mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME/fontconfig" "$XDG_STATE_HOME" \
    "$HOME/.local/share/kactivitymanagerd" /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || true
  chmod 700 "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" 2>/dev/null || true
  chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || true
else
  mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME/fontconfig" "$XDG_STATE_HOME" "$HOME/.local/share/kactivitymanagerd"
  chmod 700 "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"
fi

# Reclaim only the broken transient KDE lock chain left by older images. The
# actual user configuration and normal cache entries are left untouched.
find "$HOME/.cache" -maxdepth 1 -type f -name 'ksycoca*.lock*' -delete 2>/dev/null || true
find "$HOME/.local/state" -maxdepth 1 -type f -name 'UserFeedback*.lock*' -delete 2>/dev/null || true

# Arch xkeyboard-config 2.48 stores its data under xkeyboard-config-2. Xwayland
# still resolves the traditional X11/xkb path; recreate the compatibility link
# for existing Droidspaces rootfs instances as well as freshly built images.
if [[ ! -e /usr/share/X11/xkb && -d /usr/share/xkeyboard-config-2 ]]; then
  ln -s ../xkeyboard-config-2 /usr/share/X11/xkb 2>/dev/null || true
fi

# HOME is an Android bind mount, not /home/user. Apply profile defaults once per
# revision so upgrades can repair known-bad Plasma state without resetting user
# changes on every start.
profile_revision=20260810-1
profile_stamp="$HOME/.config/.mi-pad4-profile-revision"
profile_defaults=/usr/share/droidspaces/mi-pad4-profile
if [[ "$(cat "$profile_stamp" 2>/dev/null || true)" != "$profile_revision" ]]; then
  mkdir -p "$HOME/.config"
  for config in kwinrc kscreenlockerrc plasma-localerc \
      plasma-org.kde.plasma.desktop-appletsrc baloofilerc dolphinrc; do
    if [[ -f "$profile_defaults/$config" ]]; then
      cp -f "$profile_defaults/$config" "$HOME/.config/$config"
    elif [[ -f "/home/user/.config/$config" ]]; then
      cp -f "/home/user/.config/$config" "$HOME/.config/$config"
    fi
  done
  if [[ -d /home/user/.config/autostart ]]; then
    mkdir -p "$HOME/.config/autostart"
    cp -f /home/user/.config/autostart/*.desktop "$HOME/.config/autostart/" 2>/dev/null || true
  fi

  mkdir -p "$HOME/Desktop"
  cp -f /home/user/Desktop/*.desktop "$HOME/Desktop/" 2>/dev/null || true
  if [[ -f /usr/share/applications/firefox.desktop ]]; then
    cp -f /usr/share/applications/firefox.desktop "$HOME/Desktop/firefox.desktop"
    chmod 0755 "$HOME/Desktop/firefox.desktop"
  fi

  # Keep Dolphin away from services that are unavailable in this container.
  # Baloo tags, remote discovery and recent/timeline KIO workers otherwise get
  # created merely by opening the Places panel and can stall on the 4.4 guest.
  if [[ -f "$profile_defaults/user-places.xbel" ]]; then
    mkdir -p "$HOME/.local/share"
    cp -f "$profile_defaults/user-places.xbel" "$HOME/.local/share/user-places.xbel"
  elif [[ -f /home/user/.local/share/user-places.xbel ]]; then
    mkdir -p "$HOME/.local/share"
    cp -f /home/user/.local/share/user-places.xbel "$HOME/.local/share/user-places.xbel"
  fi
  if [[ -f "$profile_defaults/dolphin-global-viewproperties" ]]; then
    mkdir -p "$HOME/.local/share/dolphin/view_properties/global"
    cp -f "$profile_defaults/dolphin-global-viewproperties" \
      "$HOME/.local/share/dolphin/view_properties/global/.directory"
  elif [[ -f /home/user/.local/share/dolphin/view_properties/global/.directory ]]; then
    mkdir -p "$HOME/.local/share/dolphin/view_properties/global"
    cp -f /home/user/.local/share/dolphin/view_properties/global/.directory \
      "$HOME/.local/share/dolphin/view_properties/global/.directory"
  fi

  # Dolphin stores dock/window state separately from dolphinrc. A forced
  # container stop can leave an invalid Qt save-state blob; Dolphin then logs
  # "Unknown class" and can block while restoring its first window.
  if [[ -f "$XDG_STATE_HOME/dolphinstaterc" ]]; then
    mv -f "$XDG_STATE_HOME/dolphinstaterc" \
      "$XDG_STATE_HOME/dolphinstaterc.pre-mi-pad4-$profile_revision" 2>/dev/null || true
  fi
  rm -f "$HOME"/.cache/drkonqi/application-not-responding/dolphin.*.json 2>/dev/null || true
  printf '%s\n' "$profile_revision" >"$profile_stamp"
fi

# Android's keyboard is the only on-screen keyboard. Remove the old standalone
# Fcitx autostart entry so it cannot compete for text-input focus.
rm -f "$HOME/.config/autostart/fcitx5.desktop" 2>/dev/null || true

# KIO worker sockets and Dolphin session state are transient. Clean them on
# every container start, including upgrades where the profile stamp matches.
rm -f "$HOME/.config/session/dolphin_dolphin_dolphin" 2>/dev/null || true
rm -f "$XDG_STATE_HOME/dolphinstaterc" 2>/dev/null || true
rm -f "$XDG_RUNTIME_DIR"/dolphin*.kioworker.socket 2>/dev/null || true

live_plasmashell_pid() {
  local pid state
  for pid in $(pgrep -x plasmashell 2>/dev/null || true); do
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    if [[ -n "$state" && "$state" != Z* ]]; then
      echo "$pid"
      return 0
    fi
  done
  return 1
}

latest_live_pid() {
  local pattern="$1" pid state newest=""
  for pid in $(pgrep -f "$pattern" 2>/dev/null || true); do
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    if [[ -n "$state" && "$state" != Z* ]]; then
      newest="$pid"
    fi
  done
  [[ -n "$newest" ]] || return 1
  echo "$newest"
}

start_system_bus() {
  local bus_socket=/run/dbus/system_bus_socket

  if [[ -S "$bus_socket" ]]; then
    export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$bus_socket"
    return 0
  fi

  # systemd cannot provide the system bus on the tablet's 4.4 kernel. The
  # legacy dbus daemon is sufficient here and enables normal D-Bus activation
  # for udisks2, UPower and polkit without adding another supervisor.
  mkdir -p /run/dbus
  /usr/bin/dbus-daemon --system --fork --nopidfile \
    >/tmp/droidspaces-system-dbus.log 2>&1 || true
  for _ in $(seq 1 20); do
    [[ -S "$bus_socket" ]] && break
    sleep 0.1
  done
  if [[ ! -S "$bus_socket" ]]; then
    echo "system D-Bus did not become ready" >&2
    return 1
  fi
  export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$bus_socket"
}

if [[ "${1:-}" != child && "${1:-}" != shell && "${1:-}" != session ]]; then
  # runit supervises this one foreground service.  Keep KWin and the user
  # session as siblings so a failed compositor causes one clean restart rather
  # than leaving a second Plasma session behind.
  rm -f "$XDG_RUNTIME_DIR"/wayland-* \
    "$XDG_RUNTIME_DIR"/wayland-*.lock 2>/dev/null || true
  start_system_bus || true
  "$0" child >>/var/log/plasma-conc-wayland.log 2>&1 &
  child_pid=$!
  "$0" shell >>"$HOME/plasma-conc-shell.log" 2>&1 &
  shell_pid=$!

  cleanup() {
    kill "$child_pid" "$shell_pid" 2>/dev/null || true
    wait "$child_pid" "$shell_pid" 2>/dev/null || true
  }
  trap cleanup EXIT INT TERM

  process_alive() {
    local pid="$1" state
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    [[ -n "$state" && "$state" != Z* ]]
  }

  while process_alive "$child_pid" && process_alive "$shell_pid"; do
    sleep 2
  done
  exit 1
fi

# The legacy guest has no user manager to remove stale compositor locks after
# a forced container stop. Clean all transient Wayland endpoints before KWin
# binds the fixed Anland display name.
rm -f "$XDG_RUNTIME_DIR"/wayland-* \
  "$XDG_RUNTIME_DIR"/wayland-*.lock 2>/dev/null || true
chmod 666 "$XDG_RUNTIME_DIR"/wayland-*.lock 2>/dev/null || true

# Keep KWin at its packaged path so its internal QPA plugin resolves correctly.
# Only this child receives KGSL and the legacy ION shim; the desktop shell helper
# below stays on stable software/shared-memory buffers.
if [[ "${1:-}" = child ]]; then
  # D-Bus activated KDE helpers can escape the service cgroup on the legacy
  # kernel. If a previous session was force-stopped, their main thread may exit
  # while a QDBus thread spins forever as a PID-1 child. Remove the whole stale
  # desktop generation before creating the new session.
  /usr/bin/pkill -KILL -f '^/usr/sbin/kwin_wayland_wrapper( |$)' 2>/dev/null || true
  /usr/bin/pkill -KILL -f '^/usr/(sbin|bin)/kded6( |$)' 2>/dev/null || true
  /usr/bin/pkill -KILL -f '^/usr/bin/startplasma-wayland( |$)' 2>/dev/null || true
  for process in kwin_wayland Xwayland plasmashell plasma_session ksmserver dolphin pcmanfm-qt; do
    /usr/bin/pkill -KILL -x "$process" 2>/dev/null || true
  done
  mkdir -p "$XDG_RUNTIME_DIR" "$HOME" 2>/dev/null || true
  chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
  # Droidspaces exposes this bind-mounted rootfs with an execution restriction
  # to session descendants. Invoke the trusted bash binary explicitly instead
  # of asking dbus-run-session to execute the script path directly.
  exec /usr/bin/dbus-run-session -- /usr/bin/bash "$0" session
fi

if [[ "${1:-}" = session ]]; then
  if ! pgrep -x pipewire >/dev/null 2>&1; then
    nohup /usr/bin/pipewire >"$HOME/pipewire.log" 2>&1 </dev/null &
  fi
  if ! pgrep -x pipewire-pulse >/dev/null 2>&1; then
    nohup /usr/bin/pipewire-pulse >"$HOME/pipewire-pulse.log" 2>&1 </dev/null &
  fi
  if ! pgrep -x wireplumber >/dev/null 2>&1; then
    nohup /usr/bin/wireplumber >"$HOME/wireplumber.log" 2>&1 </dev/null &
  fi

  # Plasma 6 must own plasmashell through plasma_session. Launching the shell
  # directly skips its session D-Bus services and crashes during startup. The
  # wrapper gives plasma_session an Anland-capable KWin without leaking KGSL
  # variables into regular applications.
  # HOME is an Android encrypted bind mount whose contents can be read but not
  # reliably rewritten by the container. Keep this required Plasma 6 setting
  # in the writable runtime tmpfs instead.
  plasma_config_home=/run/mi-pad4-plasma-config
  mkdir -p "$plasma_config_home"
  # XDG_CONFIG_HOME is a tmpfs because config locks on Android's fscrypt mount
  # fail with ENOKEY. Seed every performance/stability setting before KWin and
  # Plasma start; otherwise they silently regenerate expensive defaults here.
  for config in kwinrc kscreenlockerrc plasma-localerc kdeglobals \
      dolphinrc baloofilerc kxkbrc mimeapps.list; do
    if [[ -s "$HOME/.config/$config" ]]; then
      cp -f "$HOME/.config/$config" "$plasma_config_home/$config"
    elif [[ -s "/home/user/.config/$config" ]]; then
      cp -f "/home/user/.config/$config" "$plasma_config_home/$config"
    fi
  done
  # Dolphin migrates Version and panel state after its first run. Always seed
  # the immutable low-overhead defaults, not the already-migrated HOME copy.
  if [[ -s "$profile_defaults/dolphinrc" ]]; then
    cp -f "$profile_defaults/dolphinrc" "$plasma_config_home/dolphinrc"
  fi
  # XDG_CONFIG_HOME points at tmpfs to avoid Android fscrypt lock failures, so
  # Plasma cannot see the packaged/persistent panel layout unless it is seeded
  # here before plasma_session starts plasmashell. Without this file KWin works
  # and submits frames to Anland, but the visible output is only a black desktop.
  if [[ ! -s "$plasma_config_home/plasma-org.kde.plasma.desktop-appletsrc" ]]; then
    for layout in \
      "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" \
      /home/user/.config/plasma-org.kde.plasma.desktop-appletsrc; do
      if [[ -s "$layout" ]]; then
        cp -f "$layout" "$plasma_config_home/plasma-org.kde.plasma.desktop-appletsrc"
        break
      fi
    done
  fi
  printf '%s\n' '[General]' 'systemdBoot=false' >"$plasma_config_home/startkderc"
  /usr/bin/kwriteconfig6 --file "$plasma_config_home/kdeglobals" \
    --group KDE --key AnimationDurationFactor 0 2>/dev/null || true
  for effect in blur contrast translucency slide slidingpopups; do
    /usr/bin/kwriteconfig6 --file "$plasma_config_home/kwinrc" \
      --group Plugins --key "${effect}Enabled" false 2>/dev/null || true
  done
  # Do not start a Linux virtual keyboard.  Anland forwards KWin's text-input
  # activation to Android and commits Android IME text back into KWin.
  /usr/bin/kwriteconfig6 --file "$plasma_config_home/kwinrc" \
    --group Wayland --key InputMethod --delete 2>/dev/null || true
  /usr/bin/kwriteconfig6 --file "$plasma_config_home/kwinrc" \
    --group Wayland --key VirtualKeyboardMode 0 2>/dev/null || true
  export XDG_CONFIG_HOME="$plasma_config_home"
  export KDEWM='/usr/bin/bash /usr/local/bin/mi-pad4-kwin-wayland'

  /usr/bin/startplasma-wayland &
  startup_pid=$!
  for _ in $(seq 1 100); do
    [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] && break
    if ! kill -0 "$startup_pid" 2>/dev/null; then
      wait "$startup_pid"
      exit 1
    fi
    sleep 0.1
  done
  if [[ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
    kill "$startup_pid" 2>/dev/null || true
    wait "$startup_pid" 2>/dev/null || true
    exit 1
  fi

  sleep 3
  shell_pid="$(live_plasmashell_pid || true)"
  if [[ -z "$shell_pid" ]]; then
    /usr/bin/plasmashell -p org.kde.plasma.desktop \
      >/run/mi-pad4-plasmashell.log 2>&1 &
    shell_pid=$!
  fi
  wait "$shell_pid"
  status=$?
  kill "$startup_pid" 2>/dev/null || true
  wait "$startup_pid" 2>/dev/null || true
  exit "$status"
fi

for _ in $(seq 1 45); do
  session_pid="$(latest_live_pid '(^|/)startplasma-wayland($| )' || true)"
  kwin_pid="$(latest_live_pid '(^|/)kwin_wayland($| )' || true)"
  if [[ -n "$session_pid" && -n "$kwin_pid" && -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
    # A stale Wayland socket survives a fast container restart.  Requiring the
    # new compositor process, then allowing its output two seconds to settle,
    # prevents Plasma from binding its panel to screen -1.
    sleep 2
    break
  fi
  sleep 1
done

if [[ -z "${session_pid:-}" ]]; then
  echo "startplasma-wayland did not become ready" >&2
  exit 1
fi

dbus_address="$(tr '\0' '\n' < "/proc/$session_pid/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)"
session_display="$(tr '\0' '\n' < "/proc/$session_pid/environ" | sed -n 's/^DISPLAY=//p' | head -n 1)"
if [[ -z "$dbus_address" ]]; then
  echo "DBUS_SESSION_BUS_ADDRESS not found for PID $session_pid" >&2
  exit 1
fi

export DBUS_SESSION_BUS_ADDRESS="$dbus_address"
export DISPLAY="${session_display:-:0}"
export QSG_RENDER_LOOP=basic

# Import only session metadata from plasma_session. Importing its full
# environment would leak KWin's KGSL and legacy-ION settings into plasmashell.
plasma_session_pid="$(latest_live_pid '(^|/)plasma_session($| )' || true)"
if [[ -n "$plasma_session_pid" && -r "/proc/$plasma_session_pid/environ" ]]; then
  while IFS='=' read -r name value; do
    case "$name" in
      KDE_FULL_SESSION|KDE_SESSION_VERSION|KDE_SESSION_UID|KDE_APPLICATIONS_AS_SCOPE|\
      XDG_CURRENT_DESKTOP|XDG_MENU_PREFIX|XDG_SESSION_TYPE|XDG_CONFIG_DIRS|\
      QT_WAYLAND_RECONNECT|_JAVA_AWT_WM_NONREPARENTING)
        export "$name=$value"
        ;;
    esac
  done < <(tr '\0' '\n' < "/proc/$plasma_session_pid/environ")
fi

# startplasma normally delegates these user services to systemd. Kernel 4.4
# cannot keep a systemd user manager alive, so launch the audio graph directly.
# Without a PipeWire server the Anland audio reconnect loop sits on a dead core
# socket and wastes one CPU core.
if ! pgrep -x pipewire >/dev/null 2>&1; then
  nohup /usr/bin/pipewire >"$HOME/pipewire.log" 2>&1 </dev/null &
fi
for _ in $(seq 1 10); do
  [[ -S "$XDG_RUNTIME_DIR/pipewire-0" ]] && break
  sleep 0.2
done
if ! pgrep -x pipewire-pulse >/dev/null 2>&1; then
  nohup /usr/bin/pipewire-pulse >"$HOME/pipewire-pulse.log" 2>&1 </dev/null &
fi
if ! pgrep -x wireplumber >/dev/null 2>&1; then
  nohup /usr/bin/wireplumber >"$HOME/wireplumber.log" 2>&1 </dev/null &
fi

# A healthy startplasma-wayland may launch plasmashell itself once the Plasma
# QML packages are complete.  Keep that instance instead of starting a second
# shell, but do not return before the audio/input services above are running.
shell_pid="$(pgrep -x plasmashell 2>/dev/null | head -n 1 || true)"
if [[ -n "$shell_pid" ]]; then
  echo "plasmashell already running: $shell_pid"
  while kill -0 "$shell_pid" 2>/dev/null; do
    sleep 5
  done
  exit 1
fi

exec /usr/bin/plasmashell -p org.kde.plasma.desktop
