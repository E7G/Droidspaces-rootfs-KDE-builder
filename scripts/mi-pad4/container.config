# Merge these values into the existing Ubuntu container configuration.
name=Ubuntu
hostname=Ubuntu
custom_init=/sbin/droidspaces-init
bind_mounts=/data/local/tmp/display_daemon.sock:/run/display.sock,/data/local/tmp/droidspaces-runtime:/tmp/droidspaces-runtime,/data/local/tmp/droidspaces-home:/tmp/droidspaces-home
enable_hw_access=1
enable_gpu_mode=1
selinux_permissive=1
force_cgroupv1=0
privileged=full
net_mode=nat
static_nat_ip=172.28.152.142
dns_servers=192.168.1.1,223.5.5.5
