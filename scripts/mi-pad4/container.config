# Merge these values into the existing Ubuntu container configuration.
name=Ubuntu
hostname=Ubuntu
custom_init=/sbin/droidspaces-init
bind_mounts=/data/local/tmp/display_daemon.sock:/run/display.sock
enable_hw_access=1
enable_gpu_mode=1
selinux_permissive=1
force_cgroupv1=1
privileged=full
net_mode=host
