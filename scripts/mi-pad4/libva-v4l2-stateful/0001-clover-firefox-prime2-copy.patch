+static void v4l2_enable_decode_output_order(V4L2Context *ctx)
+{
+    struct v4l2_control control;
+
+    memset(&control, 0, sizeof(control));
+    control.id = V4L2_CID_MPEG_VIDC_VIDEO_OUTPUT_ORDER;
+    control.value = 1;
