+int v4l2_copy_capture_dmabuf(V4L2Context *ctx, int capture_idx)
+{
+    if (capture_idx < 0 || capture_idx >= ctx->num_capture_buffers)
+        return -1;
+
+    V4L2MmapBuffer *capture = &ctx->capture_buffers[capture_idx];
+    if (!capture->plane_ptr[0] || capture->plane_len[0] == 0)
+        return -1;
+
+    V4L2MmapBuffer copy;
+    memset(&copy, 0, sizeof(copy));
+    for (uint32_t p = 0; p < VIDEO_MAX_PLANES; p++)
+        copy.plane_fd[p] = -1;
+    copy.fd = -1;
+    copy.num_planes = 1;
+
+    if (ion_alloc_buffer(ctx, &copy, 0, capture->plane_len[0]) < 0)
+        return -1;
+
+    memcpy(copy.plane_ptr[0], capture->plane_ptr[0], capture->plane_len[0]);
+    int fd = copy.plane_fd[0];
+
+    munmap(copy.plane_ptr[0], copy.plane_len[0]);
+    copy.plane_ptr[0] = NULL;
+    copy.plane_fd[0] = -1;
+    if (copy.ion_handle[0] && ctx->ion_fd >= 0) {
+        struct ion_free_legacy free_data = {
+            .handle = copy.ion_handle[0],
+        };
+        ioctl(ctx->ion_fd, ION_IOC_FREE_LEGACY, &free_data);
+    }
+
+    return fd;
+}
