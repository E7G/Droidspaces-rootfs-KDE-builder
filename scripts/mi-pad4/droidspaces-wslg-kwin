#!/bin/bash
set -euo pipefail

# Arch/Droidspaces WSLg V2 compositor launcher.
# Keep device-specific KGSL/ION tuning out of the Android app so other rootfs
# distributions can continue to use plain kwin_wayland.
unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND QT_OPENGL GALLIUM_DRIVER
unset ANLAND_DRM_DEVICE
export MESA_LOADER_DRIVER_OVERRIDE=kgsl
export FD_FORCE_KGSL=1
export FD_KGSL_ENABLE_DMABUF=1
export XWAYLAND_FORCE_KGSL_SURFACELESS=1
export KWIN_DISABLE_VULKAN=1
export ANLAND_NATIVE_FENCE=1

if [[ -f /usr/local/lib/libion-legacy-shim.so ]]; then
    if [[ -n "${LD_PRELOAD:-}" ]]; then
        export LD_PRELOAD="/usr/local/lib/libion-legacy-shim.so:${LD_PRELOAD}"
    else
        export LD_PRELOAD=/usr/local/lib/libion-legacy-shim.so
    fi
fi

kwin=/usr/bin/kwin_wayland
[[ -x "$kwin" ]] || kwin=/usr/sbin/kwin_wayland

# Prefer the performance cluster when taskset is available, but do not make
# startup depend on a particular CPU topology.
if command -v taskset >/dev/null 2>&1; then
    exec taskset -c 4-7 "$kwin" "$@"
fi
exec "$kwin" "$@"
