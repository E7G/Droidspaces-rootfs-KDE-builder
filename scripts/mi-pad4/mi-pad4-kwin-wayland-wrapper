#!/bin/bash

set -u

# Plasma 6 launches this fixed path and ignores KDEWM. Keep the KGSL variables
# scoped to KWin. Plasma/QtQuick uses session-wide native Wayland EGL, while the
# legacy ION preload remains compositor-only.
unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND QT_OPENGL GALLIUM_DRIVER
export MESA_LOADER_DRIVER_OVERRIDE=kgsl
export FD_FORCE_KGSL=1
export FD_KGSL_ENABLE_DMABUF=1
export XWAYLAND_FORCE_KGSL_SURFACELESS=1
export KWIN_DISABLE_VULKAN=1
export LD_PRELOAD=/usr/local/lib/libion-legacy-shim.so

# Let KWin use the full SDM660 performance cluster. core_ctl and schedutil may
# still idle/downclock unused CPUs, but frame submission is no longer squeezed
# onto two cores while Firefox and Android are active.
if [[ -x /usr/bin/taskset ]]; then
    exec /usr/bin/taskset -c 4-7 /usr/sbin/kwin_wayland --anland "$@"
fi
exec /usr/sbin/kwin_wayland --anland "$@"
