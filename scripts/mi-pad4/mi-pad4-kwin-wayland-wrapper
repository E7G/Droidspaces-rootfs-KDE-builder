#!/bin/bash

set -u

# Plasma 6 launches this fixed path and ignores KDEWM. Keep the KGSL variables
# scoped to KWin. Plasma/QtQuick uses session-wide native Wayland EGL, while the
# legacy ION preload remains compositor-only.
unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND QT_OPENGL GALLIUM_DRIVER
export MESA_LOADER_DRIVER_OVERRIDE=kgsl
export FD_FORCE_KGSL=1
export FD_KGSL_ENABLE_DMABUF=1
export XWAYLAND_FORCE_KGSL_SURFACELESS=1
export KWIN_DISABLE_VULKAN=1
export LD_PRELOAD=/usr/local/lib/libion-legacy-shim.so

# Clover exposes the SDM660 big cores as 4 and 7 to this container. Keep the
# compositor there so frame submission does not migrate through the little
# cluster while Android's SurfaceFlinger is handling the same frame.
if [[ -x /usr/bin/taskset ]] && /usr/bin/taskset -c 4-7 true 2>/dev/null; then
    # Keep the compositor on the SDM660 performance cluster and give it a
    # small priority boost.  The governor remains dynamic, so idle power is
    # still controlled by Android.
    exec /usr/bin/taskset -c 4-7 /usr/bin/nice -n -5 /usr/sbin/kwin_wayland --anland "$@"
fi
exec /usr/sbin/kwin_wayland --anland "$@"
