# Box64 configuration for Mi Pad 4 / SDM660 / Adreno 512
# Optimized for big.LITTLE CPU and Android hybrid kernel

[*]
BOX64_DYNAREC=1
BOX64_DYNAREC_SAFEFLAGS=1
BOX64_DYNAREC_STRONGMEM=0
BOX64_DYNAREC_BIGBLOCK=2
BOX64_DYNAREC_CALLRET=1
BOX64_MAXCPU=4
BOX64_DYNACACHE=1
BOX64_MMAP32=1

[*setup*]
# More conservative settings for installers
BOX64_DYNAREC_SAFEFLAGS=1
BOX64_DYNAREC_BIGBLOCK=1
BOX64_MAXCPU=2

[*install*]
# Stable mode for setup/installation
BOX64_DYNAREC_SAFEFLAGS=1
BOX64_DYNAREC_BIGBLOCK=1
BOX64_MAXCPU=2

[setup.exe]
BOX64_DYNAREC_SAFEFLAGS=1
BOX64_DYNAREC_BIGBLOCK=1
BOX64_MAXCPU=2

[install.exe]
BOX64_DYNAREC_SAFEFLAGS=1
BOX64_DYNAREC_BIGBLOCK=1
BOX64_MAXCPU=2

[*launcher*]
# Performance mode for game launchers
BOX64_DYNAREC_BIGBLOCK=2
BOX64_MAXCPU=4