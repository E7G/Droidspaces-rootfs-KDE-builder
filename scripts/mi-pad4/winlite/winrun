#!/usr/bin/bash

set -euo pipefail

export HOME="${HOME:-/tmp/droidspaces-home}"
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine-winlite}"
export WINEARCH=win64
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
export HODLL64="${HODLL64:-libarm64ecfex.dll}"
export HODLL="${HODLL:-wowbox64.dll}"
export LD_LIBRARY_PATH="/usr/lib/wine/aarch64-unix${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MESA_LOADER_DRIVER_OVERRIDE=kgsl
export FD_FORCE_KGSL=1
export FD_KGSL_ENABLE_DMABUF=1
export mesa_glthread=true
export MALLOC_ARENA_MAX=2

# The WinLite Hangover Wine is built with NTSync unconditionally. Wine 11.x
# selects /dev/ntsync automatically when it is available. Do not force ESYNC or
# FSYNC in that case; doing so can hide the lower-overhead in-process path.
# Older/non-NTSync Droidspaces kernels fall back to ESYNC rather than expensive
# server-only synchronization. FSYNC stays off because many Android 4.x kernels
# do not provide the futex_waitv ABI it requires.
if [[ -e /dev/ntsync && -r /dev/ntsync ]]; then
    unset WINEESYNC WINEFSYNC
    export WINLITE_SYNC=ntsync
else
    export WINEESYNC="${WINEESYNC:-1}"
    export WINEFSYNC="${WINEFSYNC:-0}"
    export WINLITE_SYNC=esync
fi

init_prefix() {
    mkdir -p "$WINEPREFIX" "$HOME/Windows"
    if [[ ! -f "$WINEPREFIX/system.reg" ]]; then
        wineboot -u
        regedit /S /usr/share/winlite/wine-default.reg || true
    fi

    # Wine's shell desktop is populated from the prefix Desktop folder. Expose
    # the persistent Droidspaces Windows directory there without a resident
    # Linux file manager or desktop shell.
    if [[ -d "$WINEPREFIX/drive_c/users" ]]; then
        while IFS= read -r desktop; do
            ln -snf "$HOME/Windows" "$desktop/Windows" 2>/dev/null || true
        done < <(find "$WINEPREFIX/drive_c/users" -mindepth 2 -maxdepth 2 -type d -name Desktop -print 2>/dev/null)
    fi
}

usage() {
    cat >&2 <<'EOF'
用法:
  winrun <程序.exe|程序.msi> [参数...]       # 最快：Wine Wayland 直出
  winrun --desktop <程序.exe|程序.msi> [...] # 在 Wine 桌面/任务栏内运行
  winrun --shell                             # 打开/恢复极简 Wine 桌面
  winrun --winecfg                           # Wine 设置
  winrun --sync-info                         # 查看 NTSync/ESYNC 当前选择
EOF
}

mode=direct
case "${1:-}" in
    --shell)
        init_prefix
        # Wine 11.x 的 shell desktop 在 X11 驱动下最完整：自带开始菜单、
        # 任务栏和托盘。它替代 LXQt Panel + PCManFM-Qt，两套 Qt 常驻进程
        # 都不再需要。空尺寸让 Wine 跟随 Xwayland 当前输出尺寸。
        exec wine explorer.exe /desktop=shell,,x11
        ;;
    --winecfg)
        init_prefix
        shift
        exec wine winecfg "$@"
        ;;
    --sync-info)
        printf 'sync=%s\n' "$WINLITE_SYNC"
        if [[ "$WINLITE_SYNC" == ntsync ]]; then
            ls -l /dev/ntsync 2>/dev/null || true
        fi
        cat /usr/share/hangover-winlite-version 2>/dev/null || true
        exit 0
        ;;
    --desktop)
        mode=desktop
        shift
        ;;
    --direct)
        shift
        ;;
    -h|--help|"")
        usage
        exit 0
        ;;
esac

(($# > 0)) || { usage; exit 2; }
init_prefix

target="$1"
shift

if [[ "$mode" == desktop ]]; then
    if [[ "${target,,}" == *.msi ]]; then
        command=(wine explorer.exe /desktop=shell,,x11 msiexec.exe /i "$target" "$@")
    else
        command=(wine explorer.exe /desktop=shell,,x11 "$target" "$@")
    fi
else
    if [[ "${target,,}" == *.msi ]]; then
        command=(wine msiexec /i "$target" "$@")
    else
        command=(wine "$target" "$@")
    fi
fi

# Only translated application launches are biased to SDM660's performance
# cluster. The always-visible Wine shell is deliberately left unpinned so the
# kernel can park big cores while idle.
if command -v taskset >/dev/null 2>&1; then
    exec nice -n -4 taskset -c 4-7 "${command[@]}"
fi
exec "${command[@]}"
