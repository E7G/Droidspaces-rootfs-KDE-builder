#!/usr/bin/bash

set -u

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/tmp/droidspaces-home
export USER=user
export LOGNAME=user
export SHELL=/usr/bin/bash
export LANG=zh_CN.UTF-8
export LANGUAGE=zh_CN:zh
export LC_ALL=zh_CN.UTF-8
export LD_LIBRARY_PATH="/usr/lib/wine/aarch64-unix${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export WINEPREFIX="$HOME/.wine-winlite"

export ANLAND=1
export ANLAND_SOCKET=/run/display.sock
export ANLAND_NATIVE_FENCE=1
unset ANLAND_DRM_DEVICE

export WAYLAND_DISPLAY=wayland-0
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=WinLite
export XDG_RUNTIME_DIR=/run/droidspaces-runtime/user-0
export XDG_CONFIG_HOME=/run/winlite-config
export XDG_CACHE_HOME=/run/winlite-cache
export XDG_STATE_HOME=/run/winlite-state
export XDG_DATA_HOME="$HOME/.local/share"
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export XKB_DEFAULT_RULES=evdev
export XKB_DEFAULT_MODEL=pc105
export XKB_DEFAULT_LAYOUT=us

export QT_QPA_PLATFORM=wayland
export QT_IM_MODULES=wayland
export QT_WAYLAND_RECONNECT=1
export GTK_USE_PORTAL=0
export PLASMA_INTEGRATION_USE_PORTAL=0
unset XMODIFIERS GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE GLFW_IM_MODULE

export MESA_LOADER_DRIVER_OVERRIDE=kgsl
export FD_FORCE_KGSL=1
export FD_KGSL_ENABLE_DMABUF=1
export MALLOC_ARENA_MAX=2
export PIPEWIRE_LATENCY=2048/48000
export PULSE_RUNTIME_PATH="$XDG_RUNTIME_DIR/pulse"
export PULSE_SERVER="unix:$PULSE_RUNTIME_PATH/native"
export PIPEWIRE_REMOTE="$XDG_RUNTIME_DIR/pipewire-0"

unset INVOCATION_ID NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC SYSTEMD_EXEC_PID

mkdir -p \
    "$HOME/Windows" "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" \
    "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$PULSE_RUNTIME_PATH" \
    /tmp/.X11-unix /tmp/.ICE-unix
chmod 700 "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix

cp -f /usr/share/winlite/kwinrc "$XDG_CONFIG_HOME/kwinrc"
cp -f /usr/share/winlite/kwinoutputconfig.json "$XDG_CONFIG_HOME/kwinoutputconfig.json"

# WinLite intentionally has no systemd-logind or ConsoleKit. KScreenLocker
# cannot safely unlock in this environment, so disable every automatic/manual
# lock path as a runtime safeguard even if the package is accidentally present.
cat >"$XDG_CONFIG_HOME/kscreenlockerrc" <<'EOF_KSCREENLOCKER'
[Daemon]
Autolock=false
Lock=false
LockOnResume=false
LockOnStart=false
RequirePassword=false
Timeout=0
EOF_KSCREENLOCKER

# A restarted graphical generation must not inherit an old Wine/Xwayland tree.
wineserver -k 2>/dev/null || true
for process in kwin_wayland Xwayland kscreenlocker_greet lxqt-panel pcmanfm-qt; do
    pkill -KILL -x "$process" 2>/dev/null || true
done
for process in pipewire pipewire-pulse wireplumber; do
    pkill -TERM -x "$process" 2>/dev/null || true
done
rm -f "$XDG_RUNTIME_DIR"/wayland-* "$XDG_RUNTIME_DIR"/pipewire-* \
    "$PULSE_RUNTIME_PATH"/native /tmp/.X11-unix/X* 2>/dev/null || true

pids=()
cleanup() {
    for pid in "${pids[@]}"; do
        kill -TERM "$pid" 2>/dev/null || true
    done
    wineserver -k 2>/dev/null || true
    sleep 0.2
    for pid in "${pids[@]}"; do
        kill -KILL "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT INT TERM

# Audio is the only resident service group besides the compositor and Wine
# shell. Large buffering cuts wakeups on the SDM660 while keeping app audio
# compatible with the Anland sink.
pipewire >/run/winlite/pipewire.log 2>&1 &
pids+=("$!")
for _ in $(seq 1 100); do
    [[ -S "$XDG_RUNTIME_DIR/pipewire-0" ]] && break
    sleep 0.1
done

pipewire-pulse >/run/winlite/pipewire-pulse.log 2>&1 &
pids+=("$!")
for _ in $(seq 1 100); do
    pactl info >/dev/null 2>&1 && break
    sleep 0.1
done

wireplumber >/run/winlite/wireplumber.log 2>&1 &
pids+=("$!")

/usr/sbin/kwin_wayland_wrapper --xwayland >/run/winlite/kwin.log 2>&1 &
kwin_pid=$!
pids+=("$kwin_pid")
for _ in $(seq 1 120); do
    [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] && break
    kill -0 "$kwin_pid" 2>/dev/null || exit 1
    sleep 0.1
done
[[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] || exit 1

# Wine's special shell desktop is currently more complete on X11 than on the
# native Wine Wayland driver. KWin already owns Xwayland for compatibility, so
# detect its display instead of hard-coding :0/:1.
x_socket=""
for _ in $(seq 1 120); do
    x_socket="$(find /tmp/.X11-unix -maxdepth 1 -type s -name 'X*' -print -quit 2>/dev/null || true)"
    [[ -n "$x_socket" ]] && break
    kill -0 "$kwin_pid" 2>/dev/null || exit 1
    sleep 0.1
done
if [[ -n "$x_socket" ]]; then
    export DISPLAY=":${x_socket##*/X}"
else
    echo 'Xwayland display did not become ready' >&2
    exit 1
fi

# Replace LXQt Panel + PCManFM-Qt with Wine's own explorer shell. It supplies
# Start menu, taskbar, tray and desktop icons from the same Wine process family,
# avoiding two resident Qt applications and their plugin stacks.
/usr/local/bin/winrun --shell >/run/winlite/wine-shell.log 2>&1 &
pids+=("$!")

# The Anland sink is created asynchronously by the compositor backend.
(
    for _ in $(seq 1 200); do
        if pactl list short sinks 2>/dev/null | grep -q '[[:space:]]anland-speaker[[:space:]]'; then
            pactl set-default-sink anland-speaker 2>/dev/null || true
            pactl set-sink-mute anland-speaker 0 2>/dev/null || true
            exit 0
        fi
        sleep 0.1
    done
) &
pids+=("$!")

wait "$kwin_pid"
