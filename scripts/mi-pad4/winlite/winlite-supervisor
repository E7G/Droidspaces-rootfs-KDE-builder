#!/usr/bin/bash

set -u

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mkdir -p /run/winlite

session_pid=""
stop_session() {
    if [[ -n "$session_pid" ]]; then
        kill -TERM "$session_pid" 2>/dev/null || true
        wait "$session_pid" 2>/dev/null || true
    fi
}
trap stop_session EXIT INT TERM

# KWin needs only a per-session bus. Do not start a system D-Bus daemon: WinLite
# has no Linux desktop services, logind, portals or hardware managers that need
# it. dbus-run-session owns and cleans up its tiny private daemon with the
# graphical generation.
while true; do
    dbus-run-session -- /usr/local/bin/winlite-session \
        >>/run/winlite/session.log 2>&1 &
    session_pid=$!
    wait "$session_pid" || true
    session_pid=""
    sleep 1
done
