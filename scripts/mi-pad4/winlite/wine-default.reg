Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Wine\Drivers]
"Graphics"="wayland,x11"
"Audio"="pulse"

[HKEY_CURRENT_USER\Software\Wine\Direct3D]
"DirectDrawRenderer"="opengl"
"Direct3DRenderer"="opengl"
"OffscreenRenderingMode"="fbo"
"VideoMemorySize"="1024"
"Multisampling"="disabled"

[HKEY_CURRENT_USER\Software\Wine\X11 Driver]
"Managed"="Y"
"Decorated"="Y"

; The special desktop named "shell" keeps Wine's own lightweight taskbar,
; Start menu and tray visible. This replaces LXQt Panel/PCManFM-Qt entirely.
[HKEY_CURRENT_USER\Software\Wine\Explorer\Desktops\shell]
"EnableShell"=dword:00000001

[HKEY_CURRENT_USER\Control Panel\Desktop]
"LogPixels"=dword:00000090
"MenuShowDelay"="0"

[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
"MinAnimate"="0"
