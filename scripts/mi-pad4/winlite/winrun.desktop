[Desktop Entry]
Type=Application
Name=Run Windows program
Name[zh_CN]=运行 Windows 程序
Comment=Open Windows executables with Hangover
Exec=/usr/local/bin/winrun-open %f
Icon=application-x-executable
Terminal=false
NoDisplay=true
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;
