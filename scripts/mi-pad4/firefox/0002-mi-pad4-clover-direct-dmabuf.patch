 void RenderDMABUFTextureHost::DeleteTextureHandle() {
+  // Linux 4.4 KGSL/ION has no dma_resv based implicit fence propagation
+  // between freedreno and msm_vidc. Without a completion wait the RDD process
+  // observes the global dmabuf reference dropping, requeues the CAPTURE buffer
+  // and the decoder overwrites NV12 while WebRender is still sampling it.
+  // Resolution switches and 1080p playback then show split green/magenta
+  // frames.
+  //
+  // Wait only when retiring a decoded YUV texture. The wait happens after the
+  // last WebRender use and before DMABufSurface's cross-process reference is
+  // released. UI/RGBA surfaces and steady-state texture sampling are not
+  // serialized. Modern kernels normally obtain this ordering from implicit
+  // dma-buf fences; Clover needs it explicitly.
+  if (mGL && mSurface->GetAsDMABufSurfaceYUV() && mGL->MakeCurrent()) {
+    mGL->fFinish();
+  }
+
   mSurface->ReleaseTextures();
 }
 
