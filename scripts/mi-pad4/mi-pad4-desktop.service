[Unit]
Description=Mi Pad 4 Anland Plasma desktop
After=local-fs.target dbus.service
Wants=dbus.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mi-pad4-start-wayland child
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=10s
Environment=SYSTEMD_DROIDSPACES_COMPAT=1

[Install]
WantedBy=multi-user.target
