#!/bin/bash

set -u

# Use FD512/KGSL for WebRender. Full-frame presentation below avoids the stale
# partial-buffer damage that caused flicker on the legacy explicit-sync path.
export MOZ_ENABLE_WAYLAND=1
export GDK_BACKEND=wayland
export EGL_PLATFORM=wayland
export XDG_RUNTIME_DIR=/run/droidspaces-runtime/user-0
export PULSE_RUNTIME_PATH="$XDG_RUNTIME_DIR/pulse"
export PULSE_SERVER="unix:$PULSE_RUNTIME_PATH/native"
export PIPEWIRE_REMOTE="$XDG_RUNTIME_DIR/pipewire-0"
# Use Firefox's native FFmpeg V4L2-M2M path. Clover exposes the decoder as
# /dev/video2; the old libva stateful bridge on /dev/video32 is not an M2M
# device and makes Firefox fall back to a CPU decoder.
export MOZ_DRM_DEVICE=/dev/dri/renderD128
# Arch Firefox's generic RDD sandbox does not whitelist Qualcomm's legacy
# msm_vidc ioctls. This affects only the media decoder process.
export MOZ_DISABLE_RDD_SANDBOX=1
# The stock Clover KGSL export path is kept as an opt-in diagnostic mode. It
# spins the Firefox renderer on this Anland/4.4 combination even for a blank
# page. The normal profile uses the low-power Wayland compositor; KWin remains
# on KGSL and video still uses V4L2-M2M.
if [[ "${MI_PAD4_FIREFOX_GPU:-0}" = 1 ]]; then
    export MESA_LOADER_DRIVER_OVERRIDE=kgsl
    export FD_FORCE_KGSL=1
    export FD_KGSL_ENABLE_DMABUF=1
    export MOZ_DISABLE_GPU_SANDBOX=1
else
    # Keep Firefox on the stable Wayland EGL path. KGSL is reserved for KWin;
    # forcing it into Firefox's WebRender process causes shader retries and a
    # busy-loop on this legacy Anland stack instead of improving playback.
    unset MESA_LOADER_DRIVER_OVERRIDE FD_FORCE_KGSL FD_KGSL_ENABLE_DMABUF
    unset MOZ_DISABLE_GPU_SANDBOX
    export MOZ_WEBRENDER=1
    # Keep Firefox's normal Wayland EGL compositor, but do not use the
    # broken direct-DMABUF window export path. This accelerates page/video
    # composition without feeding recycled browser buffers into Anland.
    unset MOZ_DRM_DEVICE LD_PRELOAD
fi
if [[ "${MI_PAD4_FIREFOX_GPU:-0}" = 1 ]]; then
    export LD_PRELOAD="/usr/local/lib/libion-legacy-shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi
unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER
unset XWAYLAND_FORCE_KGSL_SURFACELESS MOZ_X11_EGL
unset QT_QUICK_BACKEND
unset QT_OPENGL

# Avoid Android's near-INT_MAX inherited descriptor limit slowing Firefox's
# sandbox/content-process startup on a kernel without close_range().
ulimit -n 8192

firefox_root="${HOME:-/tmp/droidspaces-home}/.mozilla/firefox"
legacy_profile="$firefox_root/mi-pad4.default-release"
profile="$firefox_root/mi-pad4.fd512"
mkdir -p "$profile"

# A second Firefox instance is catastrophic on this 4 GiB tablet: two GPU
# processes and two video pages push the Android zram into reclaim storms.
# Keep the descriptor locked across exec so clicking the panel icon repeatedly
# cannot create another browser tree. Existing Firefox instances still receive
# normal single-instance URLs through Firefox's own remote protocol.
if command -v flock >/dev/null 2>&1; then
    exec 9>"$profile/.mi-pad4-launch.lock"
    # Let Firefox's native remote protocol deliver URLs to the existing
    # browser instead of silently dropping panel/file-manager launches.
    # Never create a second browser tree on the 4 GiB tablet. The desktop
    # launcher is intentionally idempotent; existing Firefox remains usable.
    flock -n 9 || exit 0
fi

# A 4.4-kernel crash can leave Firefox's lock symlink pointing at a zombie
# process. Firefox then exits immediately on the next launch, which looks like
# a broken launcher or a flashing page. Remove only locks whose recorded PID is
# absent or already a zombie; never disturb a live browser instance.
if [[ -L "$profile/lock" ]]; then
    lock_pid="$(readlink "$profile/lock" | sed -n 's/.*:+\([0-9][0-9]*\)$/\1/p')"
    lock_state=""
    [[ -n "$lock_pid" && -r "/proc/$lock_pid/stat" ]] && \
        lock_state="$(awk '{print $3}' "/proc/$lock_pid/stat" 2>/dev/null || true)"
    if [[ -z "$lock_state" || "$lock_state" = Z ]]; then
        rm -f "$profile/lock" "$profile/.parentlock"
    fi
fi

# Start from clean runtime state: the old profile accumulated incompatible GPU,
# extension and crash-session state. Migrate personal data once, but deliberately
# leave preferences, extensions, caches and session restore behind.
if [[ ! -e "$profile/.mi-pad4-migrated" ]]; then
    for file in places.sqlite favicons.sqlite cookies.sqlite permissions.sqlite \
                logins.json key4.db cert9.db; do
        [[ -f "$legacy_profile/$file" ]] && cp -p "$legacy_profile/$file" "$profile/$file"
    done
    : >"$profile/.mi-pad4-migrated"
fi

# Do this once for profiles produced by the earlier GPU experiments. Preserve
# bookmarks/cookies/passwords, but discard only restart/session and shader
# caches; restoring several old tabs was enough to start multiple content
# processes before the low-memory prefs were read.
if [[ ! -e "$profile/.mi-pad4-profile-v2" ]]; then
    rm -f "$profile/sessionstore.jsonlz4" "$profile/previous.jsonlz4"
    rm -rf "$profile/sessionstore-backups" "$profile/shader-cache" \
           "$profile/startupCache" "$profile/cache2"
    : >"$profile/.mi-pad4-profile-v2"
fi
# Never restore a multi-tab crash session on this 4 GiB tablet. It can create
# several content processes before user.js is applied and immediately exhaust
# the shared zram. History, bookmarks, cookies and passwords are untouched.
rm -f "$profile/sessionstore.jsonlz4" "$profile/previous.jsonlz4"
rm -rf "$profile/sessionstore-backups"

# Remove only stale graphics overrides if this profile survives a future tuning
# change; history, bookmarks, cookies and passwords stay untouched.
prefs="$profile/prefs.js"
if [[ -f "$prefs" ]]; then
    sed -i -E '/^user_pref\("(gfx\.(webrender|canvas|x11-egl)|layers\.acceleration|webgl|widget\.(dmabuf|wayland))([."].*)/d' "$prefs"
fi

cat >"$profile/user.js" <<'EOF'
// Mi Pad 4: keep Firefox responsive with 4 GB RAM and a 4.4 kernel.
// One content process avoids a second JS/video tree competing with KWin for
// the shared zram device. Hardware video decode remains enabled below.
user_pref("dom.ipc.processCount", 1);
user_pref("dom.ipc.processCount.webIsolated", 1);
user_pref("dom.ipc.processPrelaunch.enabled", false);
user_pref("fission.autostart", false);
user_pref("browser.tabs.unloadOnLowMemory", true);
user_pref("browser.sessionhistory.max_total_viewers", 2);
// XDG_CACHE_HOME is a RAM-backed /run directory. A second 64 MiB "disk" cache
// only increases memory pressure and swap I/O on this 4 GB device.
user_pref("browser.cache.disk.enable", false);
user_pref("browser.cache.disk.capacity", 0);
user_pref("browser.cache.memory.capacity", 16384);
user_pref("media.cache_size", 16384);
user_pref("browser.sessionstore.interval", 300000);
user_pref("browser.sessionstore.max_tabs_undo", 3);
user_pref("browser.sessionstore.max_windows_undo", 1);
user_pref("browser.pagethumbnails.capturing_disabled", true);
user_pref("toolkit.startup.max_resumed_crashes", 0);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.startup.page", 0);
user_pref("browser.startup.homepage", "about:blank");
user_pref("browser.newtabpage.enabled", false);
user_pref("browser.newtab.preload", false);
user_pref("browser.newtabpage.activity-stream.feeds.topsites", false);
user_pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
user_pref("network.prefetch-next", false);
user_pref("network.dns.disablePrefetch", false);
user_pref("network.http.speculative-parallel-limit", 2);
user_pref("network.http.max-connections", 64);
user_pref("network.http.max-persistent-connections-per-server", 6);
user_pref("browser.urlbar.speculativeConnect.enabled", true);
user_pref("toolkit.cosmeticAnimations.enabled", false);
user_pref("ui.prefersReducedMotion", 1);
user_pref("general.smoothScroll", false);
user_pref("apz.overscroll.enabled", false);
user_pref("layout.frame_rate", -1);
user_pref("accessibility.force_disabled", 1);
user_pref("media.hardware-video-decoding.enabled", true);
user_pref("media.hardware-video-decoding.force-enabled", true);
// Use Firefox's native FFmpeg V4L2-M2M decoder on /dev/video2. Do not route
// this tablet through the obsolete stateful VA-API bridge on /dev/video32.
user_pref("media.ffmpeg.vaapi.enabled", false);
user_pref("media.rdd-ffmpeg.enabled", true);
user_pref("media.rdd-vpx.enabled", true);
user_pref("media.decoder.recycle.enabled", true);
user_pref("media.ffvpx.enabled", true);
user_pref("media.ffvpx.hw.enabled", false);
// OpenH264 is only needed for WebRTC. Douyin's normal H.264 MSE stream uses
// FFmpeg/V4L2 instead; keeping the bundled plugin alive starts a separate
// software decoder process on the 4 GB Clover and wastes CPU while browsing.
user_pref("media.gmp-gmpopenh264.enabled", false);
user_pref("media.gmp-provider.enabled", false);
user_pref("media.av1.enabled", false);
// Prefer H.264 on MSE sites such as YouTube; this decoder does not expose VP9.
user_pref("media.mediasource.vp9.enabled", false);
// Device-specific presentation choice: use WebRender for Firefox page/video
// composition, but keep direct window DMABUF export disabled. The panel is a
// separate software plasmashell process, so this does not reintroduce panel
// texture reuse while removing the large CPU cost of BasicCompositor.
user_pref("media.gpu-process-decoder", true);
user_pref("gfx.webrender.all", true);
user_pref("gfx.webrender.enabled", true);
user_pref("gfx.webrender.force-disabled", false);
user_pref("gfx.webrender.precache-shaders", false);
user_pref("gfx.webrender.program-binary-disk", false);
user_pref("layers.acceleration.force-enabled", true);
user_pref("layers.acceleration.disabled", false);
user_pref("layers.gpu-process.enabled", false);
user_pref("gfx.canvas.accelerated.cache-items", 2048);
user_pref("gfx.canvas.accelerated.cache-size", 512);
user_pref("image.cache.size", 5242880);
user_pref("image.mem.decode_bytes_at_a_time", 32768);
user_pref("image.mem.shared.unmap.min_expiration_ms", 120000);
user_pref("gfx.color_management.mode", 0);
user_pref("gfx.webrender.low-quality-pinch-zoom", true);
// Full-frame presentation avoids stale/corrupt regions on legacy KGSL.
user_pref("gfx.webrender.max-partial-present-rects", 0);
user_pref("gfx.webrender.allow-partial-present-buffer-age", false);
user_pref("gfx.webrender.force-partial-present", false);
user_pref("gfx.webrender.compositor", false);
user_pref("gfx.webrender.compositor.force-enabled", false);
// Clover's legacy KGSL explicit-sync path flashes exported dmabuf frames. Keep
// the browser window on shared Wayland buffers while WebRender accelerates its
// internal scenegraph.
user_pref("widget.dmabuf.enabled", false);
user_pref("widget.dmabuf-feedback.enabled", false);
user_pref("widget.dmabuf-export.force-enabled", false);
user_pref("widget.dmabuf-webgl.enabled", false);
user_pref("widget.wayland.vsync.enabled", true);
user_pref("widget.wayland.opaque-region.enabled", true);
user_pref("media.cubeb.backend", "pulse");
user_pref("media.cubeb.force_null_context", false);
user_pref("dom.webgpu.enabled", false);
user_pref("browser.ml.enable", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("browser.newtabpage.activity-stream.feeds.telemetry", false);
user_pref("browser.newtabpage.activity-stream.telemetry", false);
user_pref("extensions.pocket.enabled", false);
user_pref("app.shield.optoutstudies.enabled", false);
user_pref("app.normandy.enabled", false);
user_pref("messaging-system.rsexperimentloader.enabled", false);
user_pref("browser.urlbar.quicksuggest.enabled", false);
user_pref("browser.urlbar.suggest.quicksuggest.nonsponsored", false);
user_pref("browser.urlbar.suggest.quicksuggest.sponsored", false);
EOF

firefox_args=(--profile "$profile" "$@")
# The SDM660 big cluster is CPU 4-7. Keep Firefox on the whole big cluster,
# not just two CPUs: Douyin's JS, compositor and decoder can run in parallel.
# The governor still scales idle cores down; this only removes the 2-core
# bottleneck during playback. Set MI_PAD4_FIREFOX_CPUS=none for kernel placement.
firefox_cpus="${MI_PAD4_FIREFOX_CPUS:-4-7}"
if [[ "$firefox_cpus" != none && -x /usr/bin/taskset ]]; then
    exec /usr/bin/taskset -c "$firefox_cpus" /usr/lib/firefox/firefox "${firefox_args[@]}"
fi
exec /usr/lib/firefox/firefox "${firefox_args[@]}"
