[Unit]
Description=D-Bus System Message Bus (legacy kernel compatible)
Documentation=man:dbus-daemon(1)
After=local-fs.target
Before=basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/dbus-daemon --system --nofork --nopidfile
Restart=on-failure
RestartSec=10s
# The rootfs lives below Android /data. Keep Android's fscrypt v1 key in the
# service session keyring or ld.so can intermittently return ENOKEY.
KeyringMode=inherit
OOMScoreAdjust=-900
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
